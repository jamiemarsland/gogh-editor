{
  // Gogh Helper — Worker config.
  //
  // JSONC (not TOML) because the "Deploy to Cloudflare" button reads this file
  // to work out what to create for the person deploying.
  //
  // dist/worker.js is generated by `python3 helper/refresh.py` and committed, so
  // there is no build step here — the button just deploys it. Edit worker.js,
  // template.html or prompt.md and rebuild; never edit dist/ by hand.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gogh-helper",
  "main": "dist/worker.js",
  "compatibility_date": "2025-01-01",

  "vars": {
    // Where the knowledge base is read from at runtime. This is the whole
    // trick: the release workflow commits a regenerated KB to main, and the
    // deployed Worker picks it up within KB_TTL_SECONDS with no redeploy.
    "KB_URL": "https://raw.githubusercontent.com/jamiemarsland/gogh-demo/main/gogh-kb.md",

    "MODEL": "claude-sonnet-4-5",
    "MAX_TOKENS": "1400",
    "KB_TTL_SECONDS": "600",
    "MAX_TURNS": "24",

    // Rate limits. DAILY_LIMIT stops one person hammering it.
    // GLOBAL_DAILY_LIMIT is the one that bounds your bill — a per-IP cap does
    // nothing against a thousand people asking twice each.
    //
    // Sized for Cloudflare's FREE KV plan, which allows 1,000 writes/day. Each
    // question spends two, so 400/day lands comfortably under. Raise these only
    // on Workers Paid ($5/mo), where KV writes are unlimited. Past the free
    // ceiling the counters fail and the Worker serves without enforcing them
    // rather than going down — watch counterErrors in /api/meta.
    "DAILY_LIMIT": "25",
    "GLOBAL_DAILY_LIMIT": "400",

    // the connector: how long a published site link lives, how many sites
    // one address may publish a day, and which gogh build the link installs
    "SITE_TTL_DAYS": "30",
    "PUBLISH_DAILY_LIMIT": "12",
    // the front door at /build: chat turns one address may spend a day
    "BUILD_DAILY_LIMIT": "30",
    // every built site carries the Move to WordPress.com helper so what
    // someone makes here need not stay in a browser tab ("" drops it)
    // the picture allowance: one address a day, and everyone together an hour
    "PICTURES_DAILY_LIMIT": "60",
    "PICTURES_HOURLY_LIMIT": "40",
    "MOVE_PLUGIN_URL": "https://github.com/jamiemarsland/playground-to-wordpress-com/archive/refs/heads/main.zip",
    "PLUGIN_ZIP_URL": "https://raw.githubusercontent.com/jamiemarsland/gogh-demo/main/gogh-playground.zip"
  },

  // No id: Cloudflare creates the namespace on deploy and links it
  // automatically (wrangler 4.45+). This is what stops the endpoint being an
  // open proxy, so it must not be removed.
  "kv_namespaces": [
    { "binding": "RATE" },
    // published site definitions for the connector ("chat to an AI, get a
    // blueprint"): each lives SITE_TTL_DAYS, then the link expires
    { "binding": "SITES" }
  ],

  "observability": { "enabled": true }
}
