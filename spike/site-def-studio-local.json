{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/?gogh-edit=1&gogh-build=1",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "gogh/gogh.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; define( 'GOGH_SITE_DEF_JSON', file_get_contents( '/wordpress/wp-content/plugins/gogh/spike/site-def-studio.json' ) ); require '/wordpress/wp-content/plugins/gogh/demo-boot.php';"
		}
	]
}