{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/?gogh-edit=1&gogh-walk=1",
	"preferredVersions": { "php": "8.2", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{ "step": "installTheme", "themeData": { "resource": "wordpress.org/themes", "slug": "twentytwentyfive" }, "options": { "activate": true } },
		{ "step": "activatePlugin", "pluginPath": "gogh/gogh.php" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; define( 'GOGH_DEMO_HEADER', 'gogh-header-classic' ); require '/wordpress/wp-content/plugins/gogh/demo-boot.php';" },
		{ "step": "setSiteOptions", "options": { "blogname": "The Yellow House" } }
	]
}
