      {
       "type": "heading",
       "x": 80,
       "y": 120,
       "w": 1040,
       "h": 216,
       "text": "A magazine about wood, made by people who would rather be in the workshop.",
       "fs": "__disp-s"
      },
      {
       "type": "image",
       "x": 80,
       "y": 384,
       "w": 500,
       "h": 336,
       "src": "https://images.unsplash.com/photo-1759523131742-af817477bcd9?w=1600&q=80&fm=jpg&fit=max",
       "alt": "Carving tools and shavings on a workbench",
       "radius": 6
      },
      {
       "type": "para",
       "x": 640,
       "y": 384,
       "w": 440,
       "h": 144,
       "text": "Offcut began in 2024 as a newsletter for a furniture class in Ludlow. It is now printed four times a year and read in forty countries, mostly by people with sawdust in their cuffs.",
       "tf": {
        "fs": 17
       }
      },
      {
       "type": "para",
       "x": 640,
       "y": 552,
       "w": 440,
       "h": 168,
       "text": "Each issue takes one kind of timber and follows it: where it grew, who felled it, who dried it, and what became of it. We pay every contributor, and we print on paper from a mill we have visited.",
       "tf": {
        "fs": 17
       }
      }
     ]
