       "cards": {
        "items": [
         {
          "t": "01 — Read it first",
          "d": "Every book is read before it is set. The design comes from the text, not from a template."
         },
         {
          "t": "02 — One typeface, used well",
          "d": "Most books need one family and a lot of patience. Ornament is the last resort, not the first."
         },
         {
          "t": "03 — Proofs on paper",
          "d": "Nothing is signed off on a screen. The final proof is printed, held, and read in a chair."
         }
