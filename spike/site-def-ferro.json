        "ls2": 0.22,
        "tt": "uppercase",
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "para",
       "x": 80,
       "y": 168,
       "w": 320,
       "h": 24,
       "text": "Rooms before facades",
       "tf": {
        "fs": 15,
        "fw": 600
       }
      },
      {
       "type": "para",
       "x": 80,
       "y": 216,
       "w": 320,
       "h": 96,
       "text": "A building is remembered from the inside. We design the afternoon light first and the elevation last.",
       "tf": {
        "fs": 15,
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "para",
       "x": 440,
       "y": 168,
       "w": 320,
       "h": 24,
       "text": "Fewer materials, better",
       "tf": {
        "fs": 15,
        "fw": 600
       }
      },
      {
       "type": "para",
       "x": 440,
       "y": 216,
       "w": 320,
       "h": 96,
       "text": "Three materials, used honestly, outlast twelve used cleverly. Most of ours are timber, brick and lime.",
       "tf": {
        "fs": 15,
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "para",
       "x": 800,
       "y": 168,
       "w": 320,
       "h": 24,
       "text": "Old buildings are a gift",
       "tf": {
        "fs": 15,
        "fw": 600
       }
      },
      {
       "type": "para",
       "x": 800,
       "y": 216,
       "w": 320,
       "h": 96,
       "text": "Half our work is a chapel, a barn or a coach house asking to be lived in again. We say yes.",
       "tf": {
        "fs": 15,
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      }
