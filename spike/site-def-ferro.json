       "tf": {
        "fs": 12,
        "fw": 600,
        "ls2": 0.22,
        "tt": "uppercase",
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "para",
       "x": 80,
       "y": 168,
       "w": 320,
       "h": 24,
       "text": "01 — Listen first",
       "tf": {
        "fs": 15,
        "fw": 600
       }
      },
      {
       "type": "para",
       "x": 80,
       "y": 216,
       "w": 320,
       "h": 96,
       "text": "We spend the first month in your rooms, not at our desks. The brief is written after we have seen how you live.",
       "tf": {
        "fs": 15,
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "para",
       "x": 440,
       "y": 168,
       "w": 320,
       "h": 24,
       "text": "02 — Draw by hand",
       "tf": {
        "fs": 15,
        "fw": 600
       }
      },
      {
       "type": "para",
       "x": 440,
       "y": 216,
       "w": 320,
       "h": 96,
       "text": "Every scheme begins as a pencil section. Computers come later, once the idea can survive a bad drawing.",
       "tf": {
        "fs": 15,
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "para",
       "x": 800,
       "y": 168,
       "w": 320,
       "h": 24,
       "text": "03 — Build it once",
       "tf": {
        "fs": 15,
        "fw": 600
       }
      },
      {
       "type": "para",
       "x": 800,
       "y": 216,
       "w": 320,
       "h": 96,
       "text": "We stay on site through the build. Details are decided with the builder, in the room, at full size.",
       "tf": {
        "fs": 15,
        "col": "color-mix(in srgb, var(--wp--preset--color--contrast, #000) 55%, transparent)"
       }
      },
      {
       "type": "box",
       "x": 80,
       "y": 336,
       "w": 1040,
       "h": 24,
       "boxBg": "linear-gradient(color-mix(in srgb, var(--wp--preset--color--contrast, #000) 16%, transparent), color-mix(in srgb, var(--wp--preset--color--contrast, #000) 16%, transparent)) center / 100% 1px no-repeat"
